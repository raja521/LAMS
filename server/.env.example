# LAMS API — server settings
#
#   cd server && cp .env.example .env
#   npm run env:check
#
# Only the three settings in "REQUIRED" below have no default. Everything else
# can stay commented out; the value shown is what the application will use, and
# each default applied is reported at boot.

# ============================================================================
# REQUIRED — the application will not start without these
# ============================================================================

# Where MongoDB lives. Local mongod, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/lams

# Signing keys for sessions. Generate a different value for each:
#   openssl rand -base64 48
# Both must be at least 32 characters, and they must not match each other.
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-random-string

# ============================================================================
# Everything below is optional. The value shown is the default.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# API_BASE_URL=http://localhost:4000
# LOG_LEVEL=info

# ---- Database --------------------------------------------------------------
# MONGODB_DB_NAME=lams

# ---- The web client --------------------------------------------------------
# The client runs as a separate site, so its address must be allowed explicitly.
# Comma-separate several origins. No trailing slash.
# CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# ---- Sessions and passwords ------------------------------------------------
# JWT_EXPIRES_IN=1h
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_ISSUER=lams-api
# JWT_AUDIENCE=lams-client
# BCRYPT_SALT_ROUNDS=12
# MIN_PASSWORD_LENGTH=12

# ---- Accounts --------------------------------------------------------------
# Whether people may create their own account from the sign-up page. A new
# account is always read-only regardless of DEFAULT_USER_ROLE; an administrator
# grants editing rights afterwards.
# ALLOW_REGISTRATION=true
#
# The role an administrator gets by default when creating a user by hand.
# One of: read_only, module_editor, admin
# DEFAULT_USER_ROLE=read_only

# ---- File storage ----------------------------------------------------------
# Relative paths resolve against the server folder.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=./uploads
# MAX_UPLOAD_BYTES=26214400
#
# Required only when STORAGE_PROVIDER=s3:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ---- Documents -------------------------------------------------------------
# TEMPLATE_DIR=./templates
# DOC_ORG_NAME=Example Conservation District
# DOC_ORG_DIVISION=Land Division
# DOC_ORG_ADDRESS=100 Main Street
# DOC_FOOTER_TEXT=Generated by LAMS
# DOC_LOCALE=en-US
# DOC_CURRENCY=USD

# ---- Reference numbering ---------------------------------------------------
# FILE_NUMBER_PREFIX=LA
# CONTRACT_NUMBER_PREFIX=CT
# PO_NUMBER_PREFIX=PO
# DOCUMENT_NUMBER_PREFIX=DOC
# DISPOSITION_NUMBER_PREFIX=LD
# NUMBER_SEQUENCE_PAD=5
# NUMBER_SEQUENCE_SCOPE=yearly

# ---- Application intake ----------------------------------------------------
# INTAKE_SOURCE=simulated
# When INTAKE_SOURCE=webhook these two become required:
# INTAKE_WEBHOOK_SECRET=
# INTAKE_FORM_SYSTEM_URL=

# ---- Parcel geometry -------------------------------------------------------
# GIS_PROVIDER=sample
# GIS_SAMPLE_DATA_PATH=./sample-data/parcels.geojson
# When GIS_PROVIDER=arcgis these three become required:
# GIS_FEATURE_SERVICE_URL=
# GIS_API_KEY=
# GIS_PARCEL_ID_FIELD=

# ---- Connections to other systems -----------------------------------------
# Each connector is off unless switched on. Turning one on makes its own
# settings required, so a half-configured connection is refused at boot.
# CONNECTOR_ARCGIS_ENABLED=false
# CONNECTOR_ACCUFUND_ENABLED=false
# CONNECTOR_CIVICPLUS_ENABLED=false
# CONNECTOR_PAPERVISION_ENABLED=false
# CONNECTOR_PERCH_ENABLED=false
# CONNECTOR_LEGACY_ENABLED=false

# ArcGIS
# ARCGIS_FEATURE_SERVICE_URL=
# ARCGIS_API_KEY=
# ARCGIS_PARCEL_ID_FIELD=
# ARCGIS_ALLOW_ATTRIBUTE_WRITE=false
# ARCGIS_WRITABLE_FIELDS=

# AccuFund (file drop — needs a writable disk)
# ACCUFUND_EXPORT_DIR=./integration/accufund/outbound
# ACCUFUND_IMPORT_DIR=./integration/accufund/inbound
# ACCUFUND_ARCHIVE_DIR=./integration/accufund/archive
# ACCUFUND_EXPORT_SCHEDULE=0 2 * * *
# ACCUFUND_IMPORT_SCHEDULE=0 3 * * *
# ACCUFUND_FILE_PREFIX=lams

# CivicPlus
# CIVICPLUS_BASE_URL=
# CIVICPLUS_API_KEY=
# CIVICPLUS_FORM_ID=
# CIVICPLUS_POLL_SCHEDULE=*/15 * * * *
# CIVICPLUS_FIELD_MAP_FILE=./templates/connectors/civicplus-field-map.json

# PaperVision
# PAPERVISION_BASE_URL=
# PAPERVISION_API_KEY=
# PAPERVISION_DOCUMENT_URL_TEMPLATE=

# PERCH (read-only)
# PERCH_BASE_URL=
# PERCH_API_KEY=

# ---- Reports and scheduling ------------------------------------------------
# SCHEDULER_ENABLED=true
# SCHEDULER_TIMEZONE=UTC
# REPORT_OUTPUT_DIR=./reports
# REPORT_MONTHLY_SCHEDULE=0 6 1 * *
# REPORT_RETENTION_DAYS=365
# REPORT_MAX_ROWS=50000

# ---- Feature toggles -------------------------------------------------------
# FEATURE_MAP=true
# FEATURE_DOCUMENT_GENERATION=true
# FEATURE_TIMBER=true

# ---- Rate limiting ---------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10
# REGISTER_RATE_LIMIT_MAX=5

# ============================================================================
# One-time tools — only needed when you run them
# ============================================================================

# npm run seed — creates the first administrator
# SEED_ADMIN_EMAIL=you@example.gov
# SEED_ADMIN_PASSWORD=a-long-passphrase
# SEED_ADMIN_FIRST_NAME=Ada
# SEED_ADMIN_LAST_NAME=Lovelace
# SEED_ORG_NAME=Example Conservation District

# npm run import:dry-run / import:apply — brings the old system's records across
# MIGRATION_SOURCE_FILE=./scripts/import/samples/legacy-export.csv
# MIGRATION_MAPPING_FILE=./scripts/import/mappings/legacy-land-tracker.json
# MIGRATION_REPORT_DIR=./scripts/import/reports
# MIGRATION_STAGING_DB_NAME=lams_migration_staging
# MIGRATION_BATCH_LABEL=initial-load
