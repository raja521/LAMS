# Environment — the real .env files must never be committed.
# These patterns have no slash, so they match at any depth: client/.env and
# server/.env are both covered, while the two .env.example files stay.
.env
.env.*
!.env.example

# Dependencies
node_modules/
.npm/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
logs/

# Generated at run time by the server
server/uploads/
server/uploads-test/
server/reports/
server/reports-test/
server/integration/
server/scripts/import/reports/*.xlsx

# Scratch
tmp/
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
