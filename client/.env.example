# LAMS web client — browser settings
#
#   cd client && cp .env.example .env
#   npm run dev
#
# Only VITE_API_BASE_URL is required. Everything else shows its default.
#
# Two things to remember about this file:
#   1. Vite only passes names beginning with VITE_ to the browser.
#   2. These values are compiled into the JavaScript at build time, so after
#      changing one you must rebuild — restarting is not enough.
#   Never put a password or a private key in here; it ships to every visitor.

# ============================================================================
# REQUIRED
# ============================================================================

# Where the API lives, including the /api suffix. No trailing slash.
VITE_API_BASE_URL=http://localhost:4000/api

# ============================================================================
# Optional — the value shown is the default
# ============================================================================

# ---- Naming ----------------------------------------------------------------
# VITE_APP_NAME=LAMS
# VITE_ORG_NAME=

# ---- Dev server ------------------------------------------------------------
# VITE_DEV_PORT=5173

# ---- Map -------------------------------------------------------------------
# VITE_MAP_PROVIDER=sample
# VITE_MAP_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
#
# Where the map opens, as "latitude,longitude". The default is Minneapolis —
# set this to your own area.
# VITE_MAP_DEFAULT_CENTER=44.9778,-93.2650
# VITE_MAP_DEFAULT_ZOOM=11
# VITE_MAP_MAX_ZOOM=19
# VITE_MAP_LAYERS=parcels,boundaries
#
# Required only when VITE_MAP_PROVIDER=arcgis:
# VITE_MAP_FEATURE_SERVICE_URL=
# VITE_MAP_API_KEY=

# ---- Feature toggles -------------------------------------------------------
# VITE_FEATURE_MAP=true
# VITE_FEATURE_DOCUMENT_GENERATION=true
# VITE_FEATURE_TIMBER=true
