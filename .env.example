# =============================================================================
# LAMS — Land Acquisition and Management Software Solution
# =============================================================================
# Copy this file to `.env` and fill in real values for your environment.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. Every value below is a
# placeholder — no real secret belongs in this file.
#
# The server validates these on boot. If a REQUIRED variable is missing it
# exits with a message naming exactly which one, and never falls back to a
# built-in default.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime  (REQUIRED)
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Public base URL of this API, used to build absolute links (e.g. OIDC redirects).
API_BASE_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# Database  (REQUIRED)
# -----------------------------------------------------------------------------
# MongoDB connection string.
# Local:   mongodb://127.0.0.1:27017/lams
# Atlas:   mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/lams?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lams

# Name of the database to use. Overrides any database in MONGODB_URI.
MONGODB_DB_NAME=lams


# -----------------------------------------------------------------------------
# Front end  (REQUIRED)
# -----------------------------------------------------------------------------
# Where the React app is served from. Used for CORS and post-login redirects.
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Values exposed to the browser bundle (Vite only inlines VITE_* names) ---
# Never put a secret behind a VITE_ prefix: it ships to every visitor.
VITE_APP_NAME=LAMS
VITE_API_BASE_URL=http://localhost:4000/api
VITE_AUTH_PROVIDER=local
VITE_ORG_NAME=District of Example
VITE_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000


# -----------------------------------------------------------------------------
# Session security  (REQUIRED)
# -----------------------------------------------------------------------------
# Secret used to sign access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=lams-api
JWT_AUDIENCE=lams-client

# Work factor for password hashing (10-14 is the usual range).
BCRYPT_SALT_ROUNDS=12


# -----------------------------------------------------------------------------
# Login system / identity provider  (REQUIRED)
# -----------------------------------------------------------------------------
# Which sign-in methods are enabled. Comma-separated: local, azure-ad
# `local`    — email + password held in the LAMS database.
# `azure-ad` — Microsoft Entra ID (Azure AD) organizational sign-in.
AUTH_PROVIDER=local

# --- Microsoft Entra ID (Azure AD) — REQUIRED only when AUTH_PROVIDER includes azure-ad ---
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=replace-me-with-the-client-secret-from-azure
AZURE_AD_REDIRECT_URI=http://localhost:4000/api/auth/azure-ad/callback
AZURE_AD_AUTHORITY=https://login.microsoftonline.com
AZURE_AD_SCOPES=openid,profile,email,User.Read
# Entra group object-id -> LAMS role. Leave blank to assign DEFAULT_USER_ROLE.
AZURE_AD_ADMIN_GROUP_ID=
AZURE_AD_EDITOR_GROUP_ID=
AZURE_AD_READONLY_GROUP_ID=

# Role given to a brand-new user when nothing else determines one.
# One of: read_only | module_editor | admin
DEFAULT_USER_ROLE=read_only


# -----------------------------------------------------------------------------
# File storage  (REQUIRED)
# -----------------------------------------------------------------------------
# Where generated documents and parcel map files live.
# One of: local | s3
STORAGE_PROVIDER=local

# --- REQUIRED when STORAGE_PROVIDER=local ---
STORAGE_LOCAL_PATH=./uploads

# --- REQUIRED when STORAGE_PROVIDER=s3 (also works for MinIO / R2 / Wasabi) ---
S3_BUCKET=lams-documents
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=replace-me-with-an-access-key-id
S3_SECRET_ACCESS_KEY=replace-me-with-a-secret-access-key
# Leave blank for real AWS; set for S3-compatible services, e.g. http://localhost:9000
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Largest upload accepted, in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400


# -----------------------------------------------------------------------------
# Document generation  (REQUIRED)
# -----------------------------------------------------------------------------
# Where the editable template files live. These are plain JSON describing the
# layout of each memo, letter and contract — change one and the output changes,
# no code edit required.
TEMPLATE_DIR=./server/templates

# Details printed in the letterhead and footer of every generated document.
DOC_ORG_NAME=District of Example
DOC_ORG_DIVISION=Land Acquisition and Management
DOC_ORG_ADDRESS=100 Example Road, Example City, ST 00000
DOC_FOOTER_TEXT=Generated by LAMS — Land Acquisition and Management Software Solution

# Formatting of dates and money inside generated documents.
DOC_LOCALE=en-US
DOC_CURRENCY=USD


# -----------------------------------------------------------------------------
# Automatic reference numbering  (REQUIRED)
# -----------------------------------------------------------------------------
# Applications, contracts, purchase orders and documents are numbered
# automatically. Prefixes and width are set here so the District's own numbering
# convention can be matched without touching code.
FILE_NUMBER_PREFIX=LA
CONTRACT_NUMBER_PREFIX=CT
PO_NUMBER_PREFIX=PO
DOCUMENT_NUMBER_PREFIX=DOC
DISPOSITION_NUMBER_PREFIX=LD
NUMBER_SEQUENCE_PAD=5
# yearly = sequence restarts each calendar year (LA-2026-00001); never = runs forever.
NUMBER_SEQUENCE_SCOPE=yearly


# -----------------------------------------------------------------------------
# Application intake  (REQUIRED)
# -----------------------------------------------------------------------------
# Where new "I want to sell land to the District" applications come from.
# simulated = the built-in generator and manual entry used until the real
#             online-form connection is wired up.
# webhook   = the form system posts to /api/acquisition/intake/webhook.
INTAKE_SOURCE=simulated
# Shared secret the form system must send as the X-LAMS-Intake-Signature header.
INTAKE_WEBHOOK_SECRET=replace-me-with-a-shared-secret
# REQUIRED when INTAKE_SOURCE=webhook — the form system this instance accepts.
INTAKE_FORM_SYSTEM_URL=


# -----------------------------------------------------------------------------
# Mapping / GIS — server side  (REQUIRED)
# -----------------------------------------------------------------------------
# sample = geometry served from a local GeoJSON file (used until the District's
#          own service is connected). arcgis = a live ArcGIS feature service.
# Both go through the same provider interface, so switching is a config change.
GIS_PROVIDER=sample

# REQUIRED when GIS_PROVIDER=sample
GIS_SAMPLE_DATA_PATH=./server/sample-data/parcels.geojson

# REQUIRED when GIS_PROVIDER=arcgis
GIS_FEATURE_SERVICE_URL=
GIS_API_KEY=
GIS_PARCEL_ID_FIELD=PARCEL_ID


# -----------------------------------------------------------------------------
# Mapping / GIS — browser side  (REQUIRED)
# -----------------------------------------------------------------------------
# Which basemap tiles to draw. Any XYZ tile service works; point this at the
# District's own ArcGIS basemap when it is available.
VITE_MAP_PROVIDER=sample
VITE_MAP_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_DEFAULT_CENTER=44.9778,-93.2650
VITE_MAP_DEFAULT_ZOOM=11
VITE_MAP_MAX_ZOOM=19
# Comma-separated overlay layers to offer in the layer switcher.
VITE_MAP_LAYERS=parcels,boundaries
# REQUIRED when VITE_MAP_PROVIDER=arcgis — never put a paid key here in a repo.
VITE_MAP_API_KEY=
VITE_MAP_FEATURE_SERVICE_URL=


# -----------------------------------------------------------------------------
# Feature toggles  (OPTIONAL — default to on)
# -----------------------------------------------------------------------------
FEATURE_MAP=true
FEATURE_DOCUMENT_GENERATION=true
FEATURE_TIMBER=true
VITE_FEATURE_MAP=true
VITE_FEATURE_DOCUMENT_GENERATION=true
VITE_FEATURE_TIMBER=true



# =============================================================================
# CONNECTIONS TO THE DISTRICT'S OTHER SYSTEMS
# =============================================================================
# Every connector is independent and OFF by default. Turning one on makes its
# own settings required — the server then refuses to start until they are set,
# rather than running with a half-configured connection. A connector that is
# off, or on but not reachable, is reported plainly in Administration →
# Integrations; nothing silently pretends the data is there.
# =============================================================================

# --- Master switches (REQUIRED) ----------------------------------------------
CONNECTOR_ARCGIS_ENABLED=false
CONNECTOR_ACCUFUND_ENABLED=false
CONNECTOR_CIVICPLUS_ENABLED=false
CONNECTOR_PAPERVISION_ENABLED=false
CONNECTOR_PERCH_ENABLED=false
CONNECTOR_LEGACY_ENABLED=false


# -----------------------------------------------------------------------------
# ArcGIS — the District's mapping system
# REQUIRED when CONNECTOR_ARCGIS_ENABLED=true
# -----------------------------------------------------------------------------
# LAMS reads location information and writes only labels/associations. It is
# never permitted to change the shape or boundary of a property — the District
# manages geometry itself. The geometry guard is enforced in code and cannot be
# switched on from configuration.
ARCGIS_FEATURE_SERVICE_URL=
ARCGIS_API_KEY=
# The attribute on the feature service that holds the District's parcel id.
ARCGIS_PARCEL_ID_FIELD=PARCEL_ID
# Whether LAMS may write labels back at all. Even when true, only the fields
# listed below can be written, and geometry is always excluded.
ARCGIS_ALLOW_ATTRIBUTE_WRITE=false
ARCGIS_WRITABLE_FIELDS=LAMS_LABEL,LAMS_PARCEL_ID,LAMS_PROGRAM,LAMS_STATUS
ARCGIS_REQUEST_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# AccuFund — the District's financial system
# REQUIRED when CONNECTOR_ACCUFUND_ENABLED=true
# -----------------------------------------------------------------------------
# A live always-on connection is not confirmed to be available, so this is a
# scheduled file transfer: LAMS writes an export file on a schedule and reads
# any response files the finance team drops in the inbound directory.
ACCUFUND_EXPORT_DIR=./integration/accufund/outbound
ACCUFUND_IMPORT_DIR=./integration/accufund/inbound
ACCUFUND_ARCHIVE_DIR=./integration/accufund/archive
# Standard five-field cron expressions.
ACCUFUND_EXPORT_SCHEDULE=0 2 * * *
ACCUFUND_IMPORT_SCHEDULE=0 3 * * *
ACCUFUND_FILE_PREFIX=LAMS_AF
ACCUFUND_CSV_DELIMITER=,
# Fund/organisation code AccuFund expects on every exported line.
ACCUFUND_FUND_CODE=
ACCUFUND_TIMEZONE=America/Chicago


# -----------------------------------------------------------------------------
# CivicPlus — the online application-intake system
# REQUIRED when CONNECTOR_CIVICPLUS_ENABLED=true
# -----------------------------------------------------------------------------
# New land-purchase applications flow in automatically instead of being typed in.
CIVICPLUS_BASE_URL=
CIVICPLUS_API_KEY=
CIVICPLUS_FORM_ID=
CIVICPLUS_POLL_SCHEDULE=*/15 * * * *
CIVICPLUS_REQUEST_TIMEOUT_MS=15000
# Maps CivicPlus form field names onto LAMS application fields. Edit this rather
# than the code when the District changes their form.
CIVICPLUS_FIELD_MAP_FILE=./server/templates/connectors/civicplus-field-map.json


# -----------------------------------------------------------------------------
# PaperVision — the District's document storage
# REQUIRED when CONNECTOR_PAPERVISION_ENABLED=true
# -----------------------------------------------------------------------------
# Documents are NOT copied into the LAMS database. LAMS stores a reference and
# a click-through link back to where the real document lives.
PAPERVISION_BASE_URL=
PAPERVISION_API_KEY=
# {documentId} is substituted when building the click-through link.
PAPERVISION_DOCUMENT_URL_TEMPLATE=https://papervision.example.gov/view?docid={documentId}
PAPERVISION_SEARCH_PATH=/api/documents/search
PAPERVISION_REQUEST_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# PERCH — the environmental-tracking system
# REQUIRED when CONNECTOR_PERCH_ENABLED=true
# -----------------------------------------------------------------------------
# Read-only by design: LAMS looks at this information and never changes it.
# There is no write path in the connector at all.
PERCH_BASE_URL=
PERCH_API_KEY=
PERCH_PARCEL_QUERY_PATH=/api/sites
PERCH_REQUEST_TIMEOUT_MS=15000


# -----------------------------------------------------------------------------
# Legacy land-tracking spreadsheet/database
# REQUIRED when CONNECTOR_LEGACY_ENABLED=true
# -----------------------------------------------------------------------------
# A one-time transfer, not a live connection. The work is done by the separate
# migration tool in ./migrations/import; this flag only makes the status of that
# transfer visible in the admin area.
LEGACY_SYSTEM_NAME=District Land Tracker


# =============================================================================
# REPORTING AND SCHEDULING
# =============================================================================
# Master switch for every background schedule (report runs, AccuFund transfers,
# CivicPlus polling). Turn off on a second app instance so schedules only run once.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Chicago

# Where scheduled report output is written, and how long it is kept.
REPORT_OUTPUT_DIR=./reports
REPORT_MONTHLY_SCHEDULE=0 6 1 * *
REPORT_RETENTION_DAYS=365
# Guard against a filter that would try to export the entire database.
REPORT_MAX_ROWS=50000


# -----------------------------------------------------------------------------
# First-run seeding  (REQUIRED only when you run `npm run seed`)
# -----------------------------------------------------------------------------
# Creates the first Administrator so someone can sign in to a fresh database.
# There is no built-in default account — if these are unset, seeding refuses to run.
SEED_ADMIN_EMAIL=admin@example.gov
SEED_ADMIN_PASSWORD=replace-me-with-a-long-passphrase
SEED_ADMIN_FIRST_NAME=First
SEED_ADMIN_LAST_NAME=Last
SEED_ORG_NAME=District of Example


# -----------------------------------------------------------------------------
# Operational  (OPTIONAL — these have documented, non-secret defaults)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10


# =============================================================================
# ONE-TIME DATA MIGRATION TOOL  (./migrations/import)
# =============================================================================
# Only needed when running the migration tool. The tool refuses to run without
# these rather than guessing — it is the one place where a wrong assumption is
# expensive to undo.
# =============================================================================

# The District's export of their current records (.csv or .xlsx).
MIGRATION_SOURCE_FILE=./migrations/import/samples/legacy-export.csv

# Which field mapping to use. Edit the mapping file, not the code, when the
# District's export columns differ from what is expected.
MIGRATION_MAPPING_FILE=./migrations/import/mappings/legacy-land-tracker.json

# The practice area. A dry run writes here and NEVER touches the real database,
# so staff can review the comparison report before anything becomes official.
MIGRATION_STAGING_DB_NAME=lams_migration_staging

# Where the comparison report is written.
MIGRATION_REPORT_DIR=./migrations/import/reports

# Label stamped on every imported record so a batch can be identified or undone.
MIGRATION_BATCH_LABEL=initial-load
